--- a/deps/uv/src/unix/async.c
+++ b/deps/uv/src/unix/async.c
@@ -281,6 +281,11 @@ static int uv__async_start(uv_loop_t* loop) {
      * it's just a placeholder and magic number which is going to be closed
      * during the cleanup, as other FDs. */
     err = uv__open_cloexec("/", O_RDONLY);
+    /* App Sandbox can deny reading the root directory.  The descriptor is
+     * only an EVFILT_USER identity, so /dev/null is equally suitable.
+     * Keep / first for chroots without /dev/null (libuv#4689). */
+    if (err == UV_EACCES || err == UV_EPERM)
+      err = uv__open_cloexec("/dev/null", O_RDONLY);
     if (err < 0)
       return err;
 
