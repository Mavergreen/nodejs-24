+#ifdef MAVERGREEN_USE_RECAULK
+/* Supply Recaulk with the loop's live level-triggered UDP readers. Recaulk owns
+ * the Mavericks readiness repair; libuv retains all registration/lifetime state. */
+static int uv__io_poll_recaulk(uv_loop_t* loop,
+                               struct kevent* events,
+                               int changes,
+                               int capacity,
+                               const struct timespec* timeout) {
+  struct uv__queue* q;
+  uv_handle_t* handle;
+  uv__io_t* w;
+  struct recaulk_udp_reader* readers;
+  size_t count = 0;
+  size_t i = 0;
+  int result;
+  int saved_errno;
+
+  uv__queue_foreach(q, &loop->handle_queue) {
+    handle = uv__queue_data(q, uv_handle_t, handle_queue);
+    if (handle->type != UV_UDP) continue;
+    w = &((uv_udp_t*) handle)->io_watcher;
+    if (w->pevents & POLLIN) count++;
+  }
+  if (count == 0)
+    return kevent(loop->backend_fd, events, changes, events, capacity, timeout);
+  readers = uv__malloc(count * sizeof(*readers));
+  if (readers == NULL) abort();
+  uv__queue_foreach(q, &loop->handle_queue) {
+    handle = uv__queue_data(q, uv_handle_t, handle_queue);
+    if (handle->type != UV_UDP) continue;
+    w = &((uv_udp_t*) handle)->io_watcher;
+    if (!(w->pevents & POLLIN)) continue;
+    readers[i].fd = w->fd;
+    readers[i].udata = NULL;
+    i++;
+  }
+  /* Same submission path as full watcher batches above; no ready events are
+   * consumed until Recaulk can return them to the normal dispatch loop. */
+  if (changes && kevent(loop->backend_fd, events, changes, NULL, 0, NULL))
+    abort();
+  result = __recaulk_kevent_wait_udp(loop->backend_fd, events, capacity, timeout,
+      readers, count, &uv__get_internal_fields(loop)->udp_wait);
+  saved_errno = errno;
+  uv__free(readers);
+  errno = saved_errno;
+  return result;
+}
+#endif
 
