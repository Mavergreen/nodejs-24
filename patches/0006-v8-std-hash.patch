Backport V8 65ce14d8731e929584344a0d65d6efd2296fa797:
[base] Remove partial specialization of std::hash
https://github.com/v8/v8/commit/65ce14d8731e929584344a0d65d6efd2296fa797

The generic specialization conflicts with libc++ 22 integral hashing across
translation units, so inspector session IDs inserted into a set cannot be found.
The profiler hunk is unnecessary in this V8 version: line_ticks_ uses int keys,
not the later std::pair<int, int> keys requiring an explicit base::hash.

--- a/deps/v8/src/base/hashing.h
+++ b/deps/v8/src/base/hashing.h
@@ -364,12 +364,4 @@ V8_BASE_BIT_SPECIALIZE_BIT_CAST(double, uint64_t)
 
 }  // namespace v8::base
 
-// Also define std::hash for all classes that can be hashed via v8::base::hash.
-namespace std {
-template <typename T>
-  requires requires { typename v8::base::hash<T>; }
-struct hash<T> : v8::base::hash<T> {};
-
-}  // namespace std
-
 #endif  // V8_BASE_HASHING_H_
--- a/deps/v8/src/wasm/canonical-types.h
+++ b/deps/v8/src/wasm/canonical-types.h
